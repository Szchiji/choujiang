BOT_TOKEN=123456:ABC-DEF...
ADMIN_IDS=123456789,987654321
WEBHOOK_URL=https://your-domain.com/webhook
# 必填。不要留空，也不要使用代码内置默认值。生产环境请用随机长字符串。
WEBHOOK_SECRET=
# 管理后台独立令牌，必填且必须与 WEBHOOK_SECRET 不同。未配置或与 Webhook 密钥相同则管理接口全部拒绝。
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_TOKEN=
PUBLIC_HOST=https://your-domain.com
DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/luckycloud
REDIS_URL=redis://redis:6379/0
