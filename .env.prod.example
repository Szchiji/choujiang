# ==================== Telegram ====================
BOT_TOKEN=123456:ABC-DEF...
ADMIN_IDS=123456789,987654321

# ==================== Webhook ====================
# 注意：域名必须与 nginx.prod.conf 中的 server_name 一致
DOMAIN=your-domain.com
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_SECRET=请用随机字符串替换
PUBLIC_HOST=https://your-domain.com

# ==================== PostgreSQL ====================
POSTGRES_USER=luckycloud
POSTGRES_PASSWORD=请用强密码替换
POSTGRES_DB=luckycloud
DATABASE_URL=postgresql+asyncpg://luckycloud:密码@db:5432/luckycloud

# ==================== Redis ====================
REDIS_URL=redis://redis:6379/0
